<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pl.kingdomcraft</groupId>
    <artifactId>captainhook-parent</artifactId>
    <name>CaptainHook-Parent</name>
    <version>2.0.0</version>
    <packaging>pom</packaging>

    <!--
        velocity  the master: the only module that talks to the database (stats, KingdomCoins, minigames,
                  achievements, season pass)
        bukkit    the client on every Paper server: collects stats, runs commands and exposes CaptainHookAPI,
                  forwarding everything to the proxy over the captainhook:main plugin messaging channel

        The wire protocol is documented in docs/NETWORK_PROTOCOL.md of the website repository.
    -->
    <modules>
        <module>velocity</module>
        <module>bukkit</module>
    </modules>

    <properties>
        <author>cammaj</author>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
